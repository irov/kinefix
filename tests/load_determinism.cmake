foreach(order 0 1)
    execute_process(COMMAND "${EXECUTABLE}" 25 ${order}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 60)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Load scenario failed (${order}): ${result}\n${output}\n${error}")
    endif()
    string(REGEX MATCH "checksum=[0-9a-f]+ step_allocations=0" fingerprint "${output}")
    if(fingerprint STREQUAL "")
        message(FATAL_ERROR "Missing deterministic fingerprint or allocation regression: ${output}")
    endif()
    if(order EQUAL 0)
        set(expected "${fingerprint}")
    elseif(NOT fingerprint STREQUAL expected)
        message(FATAL_ERROR "Insertion order changed state: ${expected} vs ${fingerprint}")
    endif()
endforeach()
message(STATUS "${expected}")
